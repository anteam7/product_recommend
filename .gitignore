# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Secret keys - never commit
*.key.json
ga4-key.json
gsc-key.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# ephemeral script outputs (generated by scripts/import-from-json.mjs etc.)
/scripts/out/

# local cron runner logs
/logs/

# dev/eval artifacts
.tmp/
.tmp-eval/
.claude/

# 통관 매니페스트 (수취인·주민·주소·전화 PII 포함 — 절대 커밋 금지)
*.xlsx
*.xls
manifestAci*
usa_info*
us_weight_*
jp_air*
jp_boat*
china_air_boat*

# Supabase CLI local artifacts (generated by `supabase link`)
/supabase/.branches
/supabase/.temp
